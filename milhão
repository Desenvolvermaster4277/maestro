window.startMillion=function(){

  currentPage="game";

  currentGame="million";

  gameState=createGameState();

  renderMillionGame();

  startQuestionTimer();

  playGameMusic();

};

function createGameState(){

  const all=[];

  for(const category of Object.keys(QUESTION_BANK)){

    QUESTION_BANK[category].forEach(item=>{

      all.push({
        category,
        question:item[0],
        correct:item[1],
        wrong:item[2]
      });

    });

  }

  const selected=shuffle(all).slice(0,15);

  return {
    questions:selected,
    index:0,
    prize:0,
    correct:0,
    wrong:0,
    answered:0,
    streak:0,
    bestStreak:0,
    time:15,
    locked:false,
    helps:{
      fifty:false,
      skip:false,
      hint:false
    },
    helpUsed:false,
    startedAt:Date.now()
  };
}

