              ${p.emoji}
            </div>

          `).join("")}

        </div>

        <div class="race-controls">

          <button
            class="primary"
            onclick="raceBoost()"
          >
            🚀 ACELERAR
          </button>

          <button
            class="secondary"
            onclick="navigate('home')"
          >
            Sair
          </button>

        </div>

        <div class="panel">

          <div class="panel-title">
            <h3>🏁 Corrida</h3>
          </div>

          <p class="muted">
            Toque em acelerar para avançar.
            O primeiro a chegar ao final vence.
          </p>

          <div
            id="raceStatus"
            style="margin-top:12px;font-weight:800"
          >
            Pronto para largar!
          </div>

        </div>

      </div>

    </section>
  `;
}

window.setupRace=function(count){

  const names=[
    userData.username,
    "Jogador 2",
    "Jogador 3"
  ];

  const emojis=[
    "🏎️",
    "🚗",
    "🏎️"
  ];

  raceState.players=[];

  for(let i=0;i<count;i++){

    raceState.players.push({
      name:names[i],
      position:0,
      emoji:emojis[i]
    });

  }

  raceState.running=true;

  renderRace();

  toast(
    count===1
      ?"🏁 Boa sorte!"
      :"🏁 Corrida iniciada!"
  );

};

window.raceBoost=function(){

  if(!raceState.players.length)return;

  if(!raceState.running){

    setupRace(1);

    return;
  }

  // Jogador principal
  raceState.players[0].position=
    Math.min(
      82,
      raceState.players[0].position+
      Math.floor(Math.random()*12)+7
    );

  // Adversários
  for(let i=1;i<raceState.players.length;i++){

    raceState.players[i].position=
      Math.min(
        82,
        raceState.players[i].position+
        Math.floor(Math.random()*13)+4
      );

  }

  raceState.players.forEach((p,i)=>{

    const car=$("car"+i);

    if(car)
      car.style.left=(20+p.position)+"%";

  });

  const winner=
    raceState.players.find(
      p=>p.position>=82
    );

  if(winner){

    raceState.running=false;
    raceState.winner=winner.name;

    const won=
      winner.name===userData.username;

    $("raceStatus").textContent=
      `🏁 ${winner.name} venceu!`;

    if(won){

      userData.xp+=50;
      userData.coins+=20;
      userData.stats.victories++;

      saveUser();

      playVictory();

      toast("🏆 Você venceu! +50 XP");

    }else{

      userData.stats.defeats++;

      saveUser();

      toast("😅 Você perdeu a corrida.");

    }

  }

};

/* ============================================================
   ÁUDIO
============================================================ */

function ensureAudio(){

  if(!soundEnabled && !musicEnabled)return;

  if(!audioContext){

    try{

      audioContext=
        new (window.AudioContext||
        window.webkitAudioContext)();

    }catch(e){

      return;
    }

  }

  if(audioContext.state==="suspended")
    audioContext.resume();
}

function tone(freq,duration,type="sine",volume=.04){

  if(!soundEnabled)return;

  ensureAudio();

  if(!audioContext)return;

  const osc=audioContext.createOscillator();
  const gain=audioContext.createGain();

  osc.type=type;
  osc.frequency.value=freq;

  gain.gain.setValueAtTime(
    volume,
    audioContext.currentTime
  );

  gain.gain.exponentialRampToValueAtTime(
    .001,
    audioContext.currentTime+duration
  );

  osc.connect(gain);
  gain.connect(audioContext.destination);

  osc.start();
  osc.stop(
    audioContext.currentTime+duration
  );
}

function playClick(){
  tone(500,.07,"sine",.035);
}

function playCorrect(){
  tone(660,.1,"sine",.05);
  setTimeout(()=>tone(880,.16,"sine",.05),90);
}

function playWrong(){
  tone(180,.18,"sawtooth",.045);
}

function playTick(){
  tone(400,.04,"square",.025);
}

function playVictory(){

  [523,659,784,1046].forEach(
    (f,i)=>{
      setTimeout(
        ()=>tone(f,.2,"sine",.055),
        i*120
      );
    }
  );

}

function playGameMusic(){

  if(!musicEnabled)return;

  ensureAudio();

  stopMusic();

  if(!audioContext)return;

  const notes=[
    261.63,
    329.63,
    392,
    523.25,
    392,
    329.63
  ];

  let i=0;

  musicTimer=setInterval(()=>{

    if(!musicEnabled)return;

    tone(
      notes[i%notes.length],
      .22,
      "triangle",
      .012
    );

    i++;

  },420);

}

function stopMusic(){

  clearInterval(musicTimer);

  musicTimer=null;

}

/* ============================================================
   EVENTOS DE INTERAÇÃO
============================================================ */

document.addEventListener(
  "pointerdown",
  ()=>{
    ensureAudio();
  },
  {once:true}
);

