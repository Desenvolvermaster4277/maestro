};

function renderRace(){

  $("main").innerHTML=`

    <section class="screen">

      <div class="container">

        <div class="hero">

          <h2>🏎️ Corrida do Milhão</h2>

          <p>
            Corrida arcade.
          </p>

        </div>

        <div class="panel">

          <div class="panel-title">
            <h3>Modo</h3>
          </div>

          <div class="grid grid-3">

            <button
              class="secondary"
              onclick="setupRace(1)"
            >
              👤 Solo
            </button>

            <button
              class="secondary"
              onclick="setupRace(2)"
            >
              👥 2 jogadores
            </button>

            <button
              class="secondary"
              onclick="setupRace(3)"
            >
              👥 3 jogadores
            </button>

          </div>

        </div>

        <div class="race-track">

          <div class="race-lane"></div>

          ${raceState.players.map((p,i)=>`

            <div
              class="car ${i===0?"one":"two"}"
              id="car${i}"
              style="
                left:${20+p.position}%;
                top:${i*130+45}px
              "
