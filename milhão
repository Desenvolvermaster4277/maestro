<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#0b0614">
<title>Minha Plataforma</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  -webkit-tap-highlight-color:transparent;
}

:root{
  --bg:#08050d;
  --bg2:#10091a;
  --card:#171022;
  --card2:#20142f;
  --purple:#8b3dff;
  --purple2:#b56cff;
  --text:#fff;
  --muted:#a99db8;
  --green:#24d17e;
  --red:#ff416c;
  --gold:#ffd84d;
  --border:rgba(255,255,255,.09);
}

body{
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
  background:
    radial-gradient(circle at 20% 0%,rgba(139,61,255,.22),transparent 35%),
    radial-gradient(circle at 100% 20%,rgba(181,108,255,.12),transparent 30%),
    var(--bg);
  color:var(--text);
  min-height:100vh;
  overflow-x:hidden;
}

button,input,select,textarea{
  font:inherit;
}

button{
  border:0;
  cursor:pointer;
}

.hidden{
  display:none!important;
}

.app{
  min-height:100vh;
}

.screen{
  min-height:100vh;
  padding-bottom:90px;
}

.container{
  width:min(1100px,94%);
  margin:auto;
}

/* LOGIN */

.auth-screen{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
}

.auth-box{
  width:min(440px,100%);
  background:rgba(23,16,34,.94);
  border:1px solid var(--border);
  border-radius:28px;
  padding:30px 22px;
  box-shadow:0 20px 80px rgba(0,0,0,.5);
}

.logo{
  text-align:center;
  margin-bottom:25px;
}

.logo-icon{
  width:82px;
  height:82px;
  margin:0 auto 14px;
  border-radius:24px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:40px;
  background:linear-gradient(135deg,#7025ff,#b45cff);
  box-shadow:0 0 35px rgba(139,61,255,.45);
}

.logo h1{
  font-size:28px;
  font-weight:900;
}

.logo p{
  color:var(--muted);
  margin-top:6px;
}

.form{
  display:flex;
  flex-direction:column;
  gap:12px;
}

.input{
  width:100%;
  background:#0d0814;
  border:1px solid var(--border);
  color:#fff;
  border-radius:15px;
  padding:15px;
  outline:none;
}

.input:focus{
  border-color:var(--purple);
  box-shadow:0 0 0 3px rgba(139,61,255,.12);
}

.primary{
  width:100%;
  padding:15px;
  border-radius:15px;
  background:linear-gradient(135deg,#7428ff,#a854ff);
  color:#fff;
  font-weight:800;
  box-shadow:0 8px 25px rgba(139,61,255,.25);
}

.secondary{
  width:100%;
  padding:14px;
  border-radius:15px;
  background:var(--card2);
  color:#fff;
  border:1px solid var(--border);
}

.text-button{
  background:none;
  color:var(--purple2);
  padding:8px;
  font-weight:700;
}

.auth-message{
  color:var(--red);
  text-align:center;
  min-height:20px;
  margin-top:5px;
}

/* HEADER */

.topbar{
  position:sticky;
  top:0;
  z-index:50;
  background:rgba(8,5,13,.86);
  backdrop-filter:blur(18px);
  border-bottom:1px solid var(--border);
}

.topbar-inner{
  width:min(1100px,94%);
  min-height:68px;
  margin:auto;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.brand{
  display:flex;
  align-items:center;
  gap:10px;
  font-weight:900;
}

.brand-icon{
  width:40px;
  height:40px;
  border-radius:12px;
  background:linear-gradient(135deg,#7428ff,#b45cff);
  display:flex;
  align-items:center;
  justify-content:center;
}

.user-mini{
  display:flex;
  align-items:center;
  gap:9px;
}

.avatar{
  width:42px;
  height:42px;
  border-radius:50%;
  object-fit:cover;
  background:var(--card2);
  border:2px solid rgba(181,108,255,.5);
}

.user-mini span{
  font-weight:700;
}

/* HOME */

.hero{
  padding:30px 0 20px;
}

.hero h2{
  font-size:32px;
  font-weight:900;
}

.hero p{
  color:var(--muted);
  margin-top:6px;
}

.stats-row{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
  margin-top:20px;
}

.stat-card{
  background:rgba(23,16,34,.8);
  border:1px solid var(--border);
  border-radius:18px;
  padding:14px;
}

.stat-card small{
  color:var(--muted);
  display:block;
  margin-bottom:5px;
}

.stat-card strong{
  font-size:18px;
}

.games{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:16px;
  margin-top:22px;
}

.game-card{
  position:relative;
  overflow:hidden;
  background:linear-gradient(145deg,#1b1029,#100917);
  border:1px solid var(--border);
  border-radius:25px;
  padding:23px;
  min-height:245px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
}

.game-card::after{
  content:"";
  position:absolute;
  width:170px;
  height:170px;
  right:-60px;
  top:-60px;
  background:rgba(139,61,255,.2);
  filter:blur(20px);
  border-radius:50%;
}

.game-icon{
  font-size:48px;
}

.game-card h3{
  font-size:25px;
  margin-top:10px;
}

.game-card p{
  color:var(--muted);
  margin:7px 0 18px;
}

.play-btn{
  position:relative;
  z-index:2;
  padding:14px;
  border-radius:15px;
  background:linear-gradient(135deg,#7428ff,#a854ff);
  color:white;
  font-weight:900;
}

/* PANELS */

.panel{
  background:rgba(23,16,34,.9);
  border:1px solid var(--border);
  border-radius:22px;
  padding:18px;
  margin-top:18px;
}

.panel-title{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom:15px;
}

.panel-title h3{
  font-size:21px;
}

.muted{
  color:var(--muted);
}

.grid{
  display:grid;
  gap:12px;
}

.grid-2{
  grid-template-columns:repeat(2,1fr);
}

.grid-3{
  grid-template-columns:repeat(3,1fr);
}

/* GAME */

.game-header{
  padding:18px 0;
}

.game-top{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
}

.game-title{
  font-size:21px;
  font-weight:900;
}

.money{
  color:var(--gold);
  font-size:19px;
  font-weight:900;
}

.progress{
  height:8px;
  background:#24172f;
  border-radius:99px;
  overflow:hidden;
  margin-top:14px;
}

.progress-bar{
  height:100%;
  width:0;
  background:linear-gradient(90deg,#7428ff,#d178ff);
  transition:width .3s;
}

.question-card{
  margin-top:14px;
  background:linear-gradient(145deg,#1c1129,#120a1b);
  border:1px solid var(--border);
  border-radius:25px;
  padding:20px;
}

.question-meta{
  display:flex;
  justify-content:space-between;
  align-items:center;
  color:var(--muted);
  font-size:14px;
}

.difficulty{
  padding:7px 10px;
  border-radius:10px;
  background:#2b193c;
  color:#d8b8ff;
  font-weight:800;
}

.timer{
  margin:22px auto;
  width:78px;
  height:78px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:27px;
  font-weight:900;
  border:5px solid var(--purple);
  box-shadow:0 0 25px rgba(139,61,255,.3);
}

.question{
  font-size:23px;
  line-height:1.3;
  text-align:center;
  font-weight:800;
  margin:18px 0 22px;
}

.answers{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:11px;
}

.answer{
  min-height:64px;
  padding:13px;
  border-radius:16px;
  background:#21142f;
  color:#fff;
  border:1px solid rgba(255,255,255,.08);
  text-align:left;
  font-weight:700;
  transition:.2s;
}

.answer:hover{
  border-color:var(--purple2);
  transform:translateY(-1px);
}

.answer.correct{
  background:rgba(36,209,126,.2);
  border-color:var(--green);
}

.answer.wrong{
  background:rgba(255,65,108,.2);
  border-color:var(--red);
}

.answer:disabled{
  cursor:default;
}

.helps{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
  margin-top:14px;
}

.help{
  background:#1b1027;
  color:#fff;
  border:1px solid var(--border);
  border-radius:14px;
  padding:12px 8px;
  font-weight:800;
}

.help:disabled{
  opacity:.35;
}

.game-nav{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:8px;
  margin:16px 0;
}

.game-nav button{
  padding:11px 5px;
  border-radius:13px;
  background:#171022;
  border:1px solid var(--border);
  color:#ddd;
  font-size:12px;
  font-weight:700;
}

.game-nav button.active{
  background:rgba(139,61,255,.25);
  border-color:var(--purple);
  color:#fff;
}

/* PROFILE */

.profile-head{
  display:flex;
  align-items:center;
  gap:16px;
}

.profile-avatar{
  width:90px;
  height:90px;
  border-radius:50%;
  object-fit:cover;
  border:3px solid var(--purple2);
}

.profile-name{
  font-size:25px;
  font-weight:900;
}

.level-badge{
  display:inline-block;
  margin-top:6px;
  padding:5px 9px;
  border-radius:9px;
  background:#2a183b;
  color:#d6b2ff;
  font-size:12px;
  font-weight:800;
}

.xp-wrap{
  margin-top:18px;
}

.xp-info{
  display:flex;
  justify-content:space-between;
  font-size:13px;
  margin-bottom:7px;
}

.xp-bar{
  height:10px;
  border-radius:99px;
  background:#291a38;
  overflow:hidden;
}

.xp-fill{
  height:100%;
  background:linear-gradient(90deg,#8b3dff,#d178ff);
}

/* LIST */

.list{
  display:flex;
  flex-direction:column;
  gap:10px;
}

.list-item{
  display:flex;
  align-items:center;
  gap:12px;
  padding:12px;
  border-radius:15px;
  background:#130c1c;
  border:1px solid var(--border);
}

.list-main{
  flex:1;
  min-width:0;
}

.list-main strong{
  display:block;
}

.list-main small{
  color:var(--muted);
}

/* RANKING */

.rank-item{
  display:grid;
  grid-template-columns:38px 45px 1fr auto;
  align-items:center;
  gap:10px;
  padding:12px;
  background:#130c1c;
  border:1px solid var(--border);
  border-radius:16px;
}

.rank-number{
  font-size:20px;
  font-weight:900;
  text-align:center;
}

.rank-score{
  text-align:right;
}

.rank-score strong{
  display:block;
  color:var(--gold);
}

.rank-score small{
  color:var(--muted);
}

/* ACHIEVEMENTS */

.achievement{
  display:flex;
  gap:12px;
  align-items:center;
  padding:14px;
  background:#130c1c;
  border:1px solid var(--border);
  border-radius:16px;
}

.achievement-icon{
  width:48px;
  height:48px;
  flex:none;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:14px;
  background:#2a183b;
  font-size:24px;
}

.achievement.locked{
  opacity:.42;
}

.achievement strong{
  display:block;
  margin-bottom:4px;
}

.achievement small{
  color:var(--muted);
}

/* BOTTOM NAV */

.bottom-nav{
  position:fixed;
  z-index:100;
  bottom:0;
  left:0;
  right:0;
  background:rgba(11,7,17,.94);
  backdrop-filter:blur(18px);
  border-top:1px solid var(--border);
  padding:8px 6px calc(8px + env(safe-area-inset-bottom));
}

.bottom-inner{
  width:min(700px,100%);
  margin:auto;
  display:grid;
  grid-template-columns:repeat(5,1fr);
}

.bottom-nav button{
  background:none;
  color:#887d94;
  padding:7px 3px;
  font-size:11px;
}

.bottom-nav button span{
  display:block;
  font-size:20px;
  margin-bottom:3px;
}

.bottom-nav button.active{
  color:#c894ff;
}

/* MODAL */

.modal{
  position:fixed;
  inset:0;
  z-index:200;
  background:rgba(0,0,0,.72);
  backdrop-filter:blur(8px);
  display:flex;
  align-items:flex-end;
  justify-content:center;
  padding:15px;
}

.modal-box{
  width:min(520px,100%);
  max-height:90vh;
  overflow:auto;
  background:#160d21;
  border:1px solid var(--border);
  border-radius:25px;
  padding:20px;
}

.modal-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:15px;
}

.close{
  width:38px;
  height:38px;
  border-radius:12px;
  background:#27172f;
  color:#fff;
}

/* RESULT */

.result{
  text-align:center;
  padding:30px 5px;
}

.result-trophy{
  font-size:65px;
  margin-bottom:10px;
}

.result h2{
  font-size:30px;
}

.prize{
  font-size:35px;
  font-weight:900;
  color:var(--gold);
  margin:15px 0;
}

.result-stats{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin:20px 0;
}

.result-stat{
  background:#20132d;
  border-radius:15px;
  padding:14px;
}

.result-stat small{
  color:var(--muted);
  display:block;
}

/* RACE */

.race-track{
  position:relative;
  overflow:hidden;
  height:300px;
  border-radius:22px;
  background:
    repeating-linear-gradient(
      0deg,
      #18111e 0px,
      #18111e 38px,
      #21172a 38px,
      #21172a 40px
    );
  border:1px solid var(--border);
  margin-top:16px;
}

.race-lane{
  position:absolute;
  left:0;
  right:0;
  height:50%;
  border-bottom:1px dashed rgba(255,255,255,.18);
}

.car{
  position:absolute;
  left:20px;
  width:58px;
  height:32px;
  border-radius:10px;
  background:linear-gradient(135deg,#8b3dff,#d178ff);
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:22px;
  transition:left .25s;
}

.car.one{
  top:65px;
}

.car.two{
  top:205px;
}

.race-controls{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin-top:15px;
}

/* TOAST */

.toast{
  position:fixed;
  z-index:300;
  left:50%;
  bottom:90px;
  transform:translateX(-50%) translateY(20px);
  opacity:0;
  pointer-events:none;
  background:#24132f;
  border:1px solid var(--border);
  padding:13px 17px;
  border-radius:14px;
  box-shadow:0 15px 40px rgba(0,0,0,.45);
  transition:.25s;
  max-width:90%;
  text-align:center;
}

.toast.show{
  opacity:1;
  transform:translateX(-50%) translateY(0);
}

/* RESPONSIVE */

@media(max-width:650px){
  .container{
    width:92%;
  }

  .hero h2{
    font-size:27px;
  }

  .stats-row{
    grid-template-columns:1fr 1fr 1fr;
  }

  .stat-card{
    padding:10px 8px;
  }

  .stat-card strong{
    font-size:15px;
  }

  .answers{
    grid-template-columns:1fr;
  }

  .question{
    font-size:20px;
  }

  .grid-3{
    grid-template-columns:1fr 1fr;
  }

  .rank-item{
    grid-template-columns:30px 40px 1fr auto;
  }
}

@media(max-width:380px){
  .bottom-nav button{
    font-size:9px;
  }

  .bottom-nav button span{
    font-size:18px;
  }

  .helps{
    gap:6px;
  }

  .help{
    font-size:12px;
  }
}
</style>
</head>

