/* ============================================================
   GERADOR DE QUESTÕES MATEMÁTICAS
============================================================ */

function generateMathQuestions(count=100){

  const result=[];

  for(let i=0;i<count;i++){

    const type=i%5;

    let q,a,w1,w2,w3;

    if(type===0){
      const x=Math.floor(Math.random()*50)+10;
      const y=Math.floor(Math.random()*40)+5;
      a=String(x+y);
      q=`Quanto é ${x} + ${y}?`;
      w1=String(x+y+3);
      w2=String(x+y-2);
      w3=String(x+y+7);
    }

    else if(type===1){
      const x=Math.floor(Math.random()*30)+10;
      const y=Math.floor(Math.random()*9)+2;
      a=String(x*y);
      q=`Quanto é ${x} × ${y}?`;
      w1=String(x*y+5);
      w2=String(x*y-4);
      w3=String(x*y+9);
    }

    else if(type===2){
      const y=Math.floor(Math.random()*20)+2;
      const aNum=y*Math.floor(Math.random()*10+2);
      a=String(aNum/y);
      q=`Quanto é ${aNum} ÷ ${y}?`;
      w1=String(Number(a)+1);
      w2=String(Math.max(1,Number(a)-1));
      w3=String(Number(a)+2);
    }

    else if(type===3){
      const x=Math.floor(Math.random()*20)+2;
      a=String(x*x);
      q=`Quanto é ${x}²?`;
      w1=String(x*x+10);
      w2=String(x*x-5);
      w3=String(x*x+20);
    }

    else{
      const base=Math.floor(Math.random()*9)+2;
      const pct=[10,20,25,50][Math.floor(Math.random()*4)];
      a=String(base*10*pct/100);
      q=`Quanto é ${pct}% de ${base*10}?`;
      w1=String(Number(a)+5);
      w2=String(Math.max(1,Number(a)-5));
      w3=String(Number(a)+10);
    }

    result.push([q,a,[w1,w2,w3]]);
  }

  return result;
}

