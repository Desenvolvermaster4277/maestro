window.showRegister=function(){

  $("loginForm").innerHTML=`

    <form class="form" id="formRegister">

      <input
        class="input"
        id="registerName"
        type="text"
        placeholder="Nome de usuário"
        maxlength="24"
        required
      >

      <input
        class="input"
        id="registerEmail"
        type="email"
        placeholder="Email"
        required
      >

      <input
        class="input"
        id="registerPassword"
        type="password"
        placeholder="Senha"
        minlength="6"
        required
      >

      <button class="primary" type="submit">
        CRIAR CONTA
      </button>

    </form>

    <p class="auth-message" id="authMessage"></p>

    <button
      class="text-button"
      style="width:100%;margin-top:10px"
      onclick="renderLogin()"
    >
      Já tenho uma conta
    </button>
  `;

  $("formRegister").addEventListener("submit",async e=>{

    e.preventDefault();

    const name=$("registerName").value.trim();
    const email=$("registerEmail").value.trim();
    const password=$("registerPassword").value;

    if(name.length<2){

      $("authMessage").textContent=
        "Escolha um nome com pelo menos 2 caracteres.";

      return;
    }

    try{

      const cred=await createUserWithEmailAndPassword(
        auth,
        email,
        password
      );

      await updateProfile(
        cred.user,
        {displayName:name}
      );

      const data=defaultUserData(
        cred.user,
        name,
        email
      );

      await setDoc(
        doc(db,"Usuarios",cred.user.uid),
        data
      );

    }catch(err){

      let msg="Não foi possível criar a conta.";

      if(err.code==="auth/email-already-in-use")
        msg="Este email já está cadastrado.";

      if(err.code==="auth/weak-password")
        msg="A senha precisa ter pelo menos 6 caracteres.";

      $("authMessage").textContent=msg;
    }
  });
};

