      query(
        collection(db,"Partidas"),
        orderBy("record","desc"),
        limit(50)
      )
    );

    return snap.docs
      .filter(d=>d.id.startsWith("ranking_"))
      .map(d=>d.data())
      .sort((a,b)=>
        Number(b.record||0)-Number(a.record||0)
      );

  }catch(e){

    console.warn(e);

    return [];
  }
}

