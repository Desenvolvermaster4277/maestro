function updateHelpButtons(){

  if(!gameState)return;

  $("help50").disabled=gameState.helps.fifty;
  $("helpSkip").disabled=gameState.helps.skip;
  $("helpHint").disabled=gameState.helps.hint;
}

function startQuestionTimer(){

  clearInterval(timerInterval);

  if(!gameState)return;

  gameState.time=15;

  const timer=$("timer");

  if(timer)timer.textContent="15";

  timerInterval=setInterval(()=>{

    if(!gameState)return;

    gameState.time--;

    const el=$("timer");

    if(el)el.textContent=gameState.time;

    if(gameState.time<=5){
      playTick();
    }

    if(gameState.time<=0){

      clearInterval(timerInterval);

      timeOut();

    }

  },1000);
}

function answerQuestion(index){

  if(!gameState || gameState.locked)return;

  gameState.locked=true;

  clearInterval(timerInterval);

  const selected=gameState.currentAnswers[index];

  const buttons=[
    ...document.querySelectorAll(".answer")
  ];

  buttons.forEach(b=>b.disabled=true);

  if(selected.correct){

    buttons[index].classList.add("correct");

    gameState.correct++;
    gameState.answered++;
    gameState.streak++;

    gameState.bestStreak=Math.max(
      gameState.bestStreak,
      gameState.streak
    );

    gameState.prize=PRIZES[gameState.index];

    playCorrect();

  }else{

    buttons[index].classList.add("wrong");

    const correctIndex=
      gameState.currentAnswers.findIndex(a=>a.correct);

    if(buttons[correctIndex])
      buttons[correctIndex].classList.add("correct");

    gameState.wrong++;
    gameState.answered++;
    gameState.streak=0;

    playWrong();
  }

  setTimeout(()=>{

    if(!gameState)return;

    if(!selected.correct){

      finishMillion(false);

      return;
    }

    if(gameState.index>=14){

      finishMillion(true);

      return;
    }

    gameState.index++;
    gameState.locked=false;

    renderMillionGame();

  },1100);
}

function timeOut(){

  if(!gameState || gameState.locked)return;

  gameState.locked=true;
  gameState.wrong++;
  gameState.answered++;
  gameState.streak=0;

  const buttons=[
    ...document.querySelectorAll(".answer")
  ];

  buttons.forEach(b=>b.disabled=true);

  toast("⏰ Tempo esgotado!");

  playWrong();

  setTimeout(()=>{

    finishMillion(false);

  },1000);
}

window.answerQuestion=answerQuestion;

window.useFifty=function(){

  if(!gameState || gameState.locked || gameState.helps.fifty)return;

  gameState.helps.fifty=true;
  gameState.helpUsed=true;

  const wrongIndexes=gameState.currentAnswers
    .map((a,i)=>!a.correct?i:-1)
    .filter(i=>i>=0);

  shuffle(wrongIndexes)
    .slice(0,2)
    .forEach(i=>{

      const btn=document.querySelector(
        `.answer[data-index="${i}"]`
      );

      if(btn){
        btn.disabled=true;
        btn.style.visibility="hidden";
      }

    });

  updateHelpButtons();

  playClick();
};

window.useSkip=function(){

  if(!gameState || gameState.locked || gameState.helps.skip)return;

  gameState.helps.skip=true;
  gameState.helpUsed=true;

  clearInterval(timerInterval);

  toast("⏭️ Pergunta pulada.");

  playClick();

  setTimeout(()=>{

    if(gameState.index>=14){

      finishMillion(false);

      return;
    }

    gameState.index++;
    gameState.locked=false;

    renderMillionGame();

  },500);
};

window.useHint=function(){

  if(!gameState || gameState.locked || gameState.helps.hint)return;

  gameState.helps.hint=true;
  gameState.helpUsed=true;

  const q=gameState.questions[gameState.index];

  let hint="Pense com calma e elimine as alternativas menos prováveis.";

  if(q.category==="Matemática")
    hint="Faça a conta passo a passo.";

  if(q.category==="História")
    hint="Pense no período histórico relacionado ao acontecimento.";

  if(q.category==="Geografia")
    hint="Lembre-se dos países, capitais e continentes.";

  if(q.category==="Ciência")
    hint="Pense no conceito científico envolvido.";

  if(q.category==="Tecnologia")
    hint="Considere os termos e tecnologias mais conhecidos.";

  toast("💡 "+hint);

  updateHelpButtons();

  playClick();
};

async function finishMillion(won){

  clearInterval(timerInterval);

  if(!gameState)return;

  const prize=gameState.prize;

  const xpGain=
    gameState.correct*20+
    (won?300:0)+
    Math.floor(prize/10000);

  const coinsGain=
    gameState.correct*5+
    (won?100:10);

  userData.xp+=xpGain;
  userData.coins+=coinsGain;

  userData.stats.games++;
  userData.stats.correct+=gameState.correct;
  userData.stats.wrong+=gameState.wrong;
  userData.stats.answered+=gameState.answered;

  userData.stats.bestStreak=Math.max(
    userData.stats.bestStreak,
    gameState.bestStreak
  );

  if(won)
    userData.stats.victories++;
  else
    userData.stats.defeats++;

  if(!gameState.helpUsed && won)
    userData.stats.noHelpWins++;

  userData.record=Math.max(
    userData.record,
    prize
  );

  userData.highestPrize=Math.max(
    userData.highestPrize,
    prize
  );

  const previousAchievements=[
    ...(userData.achievements||[])
  ];

  const unlocked=[];

  for(const a of ACHIEVEMENTS){

    if(
      !previousAchievements.includes(a.id) &&
      a.check({
        ...userData.stats,
        record:userData.record
      })
    ){

      userData.achievements.push(a.id);
      unlocked.push(a);

    }

  }

  await saveUser();

  await publishRanking();

  gameState=null;

  if(won)playVictory();

  $("main").innerHTML=`

    <section class="screen">

      <div class="container">

        <div class="panel">

          <div class="result">

            <div class="result-trophy">
              ${won?"🏆":"💥"}
            </div>

            <h2>
              ${won?"PARABÉNS!":"FIM DA PARTIDA"}
            </h2>

            <p class="muted">
              ${esc(userData.username)}
            </p>

            <div class="prize">
              ${money(prize)}
            </div>

            <div class="result-stats">

              <div class="result-stat">
                <small>Acertos</small>
                <strong>${userData.stats.correct}</strong>
              </div>

              <div class="result-stat">
                <small>Acertos nesta partida</small>
                <strong>${gameState?.correct??"—"}</strong>
              </div>

              <div class="result-stat">
                <small>XP ganho</small>
                <strong>+${xpGain}</strong>
              </div>

              <div class="result-stat">
                <small>Moedas ganhas</small>
                <strong>+${coinsGain}</strong>
              </div>

            </div>

            ${
              unlocked.length
              ?`
                <div class="panel" style="text-align:left">
                  <div class="panel-title">
                    <h3>🎉 Conquistas desbloqueadas</h3>
                  </div>

                  ${unlocked.map(a=>`
                    <div class="achievement">
                      <div class="achievement-icon">
                        ${a.icon}
                      </div>
                      <div>
                        <strong>${esc(a.name)}</strong>
                        <small>${esc(a.desc)}</small>
                      </div>
                    </div>
                  `).join("")}
                </div>
              `
              :""
            }

            <button
              class="primary"
              onclick="startMillion()"
            >
              🔄 JOGAR NOVAMENTE
            </button>

            <button
              class="secondary"
              style="margin-top:10px"
              onclick="navigate('home')"
            >
              VOLTAR
            </button>

            <button
              class="secondary"
              style="margin-top:10px"
              onclick="shareResult(${prize},${gameState?.correct||0})"
            >
              📤 COMPARTILHAR RESULTADO
            </button>

          </div>

        </div>

      </div>

    </section>
  `;

  // O estado foi limpo acima. Os valores importantes já foram
  // calculados antes da tela final.

}

window.shareResult=async function(prize,correct){

  const text=
    `Eu joguei o Desafio do Milhão e consegui ${money(prize)}! `+
    `Acertos: ${correct}.`;

  if(navigator.share){

    try{

      await navigator.share({
        title:"Desafio do Milhão",
        text
      });

    }catch(e){}

  }else{

    try{

      await navigator.clipboard.writeText(text);

      toast("Resultado copiado!");

    }catch(e){

      toast(text);

    }

  }
};

