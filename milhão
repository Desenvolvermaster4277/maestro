    0,
    Math.min(
      100,
      ((userData.xp-current)/(next-current))*100
    )
  );

  return `

    <div class="xp-wrap">

      <div class="xp-info">

        <span>Nível ${level}</span>

        <span>
          ${Number(userData.xp-current).toLocaleString("pt-BR")}
