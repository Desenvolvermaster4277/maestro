        await updateDoc(
          doc(db,"Notificacoes",n.id),
          {lida:true}
        );

      }

    }

  }catch(e){

    $("notificationList").innerHTML=
      `<p class="muted">
        Não foi possível carregar as notificações.
      </p>`;

  }
}

