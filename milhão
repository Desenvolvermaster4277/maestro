const $=id=>document.getElementById(id);

function esc(value){
  return String(value??"")
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");
}

function money(v){
  return "R$ "+Number(v||0).toLocaleString("pt-BR");
}

function toast(msg){
  const el=$("toast");
  if(!el)return;
  el.textContent=msg;
  el.classList.add("show");
  clearTimeout(window.__toastTimer);
  window.__toastTimer=setTimeout(()=>{
    el.classList.remove("show");
  },2600);
}

function shuffle(arr){
  const a=[...arr];
  for(let i=a.length-1;i>0;i--){
    const j=Math.floor(Math.random()*(i+1));
    [a[i],a[j]]=[a[j],a[i]];
  }
  return a;
}

function uid(){
  return Math.random().toString(36).slice(2)+Date.now().toString(36);
}

function levelFromXP(xp){
  return Math.floor(Math.sqrt(Number(xp||0)/100))+1;
}

function xpForLevel(level){
  return Math.pow(Math.max(0,level-1),2)*100;
}

function xpToNext(level){
  return Math.pow(level,2)*100;
}

function getTitle(level,record){
  if(record>=1000000)return "Lenda";
  if(level>=20)return "Milionário";
  if(level>=15)return "Especialista";
  if(level>=10)return "Mestre";
  if(level>=6)return "Conhecedor";
  if(level>=3)return "Estudante";
  return "Novato";
}

function todayKey(){
  const d=new Date();
  return d.toISOString().slice(0,10);
}

