onAuthStateChanged(auth,async user=>{

  currentUser=user;

  if(user){

    await loadUser();

    renderApp();

    startPresence();

  }else{

    userData=null;
    renderLogin();

  }
});

async function loadUser(){

  const ref=doc(db,"Usuarios",currentUser.uid);
  const snap=await getDoc(ref);

  if(snap.exists()){

    userData={
      ...defaultUserData(
        currentUser,
        currentUser.displayName,
        currentUser.email
      ),
      ...snap.data()
    };

    userData.stats={
      ...defaultUserData(currentUser,currentUser.displayName,currentUser.email).stats,
      ...(snap.data().stats||{})
    };

    userData.settings={
      ...defaultUserData(currentUser,currentUser.displayName,currentUser.email).settings,
      ...(snap.data().settings||{})
    };

  }else{

    userData=defaultUserData(
      currentUser,
      currentUser.displayName,
      currentUser.email
    );

    await setDoc(ref,userData);
  }

  const level=levelFromXP(userData.xp);
  const title=getTitle(level,userData.record);

  if(level!==userData.level || title!==userData.title){

    userData.level=level;
    userData.title=title;

    await updateDoc(ref,{
      level,
      title
    });
  }
}

async function saveUser(){

  if(!currentUser||!userData)return;

  userData.level=levelFromXP(userData.xp);
  userData.title=getTitle(userData.level,userData.record);

  await setDoc(
    doc(db,"Usuarios",currentUser.uid),
    userData,
    {merge:true}
  );
}

